            <Label>RebootRequired</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ExtendedErrorCode</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>CorrelationData</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>$_.Id</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
